{
  "manifest_version": 3,
  "name": "ChatGPT Persian RTL Support",
  "description": "Adds user-controlled Auto, RTL, and LTR direction support to ChatGPT messages and composer.",
  "version": "1.1.0",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ]
}
